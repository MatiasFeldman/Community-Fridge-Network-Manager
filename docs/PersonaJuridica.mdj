							},
							"font": "Arial;13;0",
							"left": 600,
							"top": 152,
							"width": 200,
							"height": 72,
							"text": "en lo de las ofertas, se refiere a personas juridicas a nuevas orgnizaciones que deciden contribur con sos pructos"
						},
