<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <base href="/">
    <title>{{this.titulo}}</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/style-btn.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="https://unpkg.com/htmx.org@2.0.2"
            integrity="sha384-Y7hw+L/jvKeWIRRkqWYfPcvVxHzVzn5REgzbawhxAuQGwX1XWe70vji+VSeHOThJ"
            crossorigin="anonymous"></script>
    {{#block "styles"}}
    {{/block}}
</head>
<body>

<!-- Header -->
<header class="bg-platinum border-bottom d-flex justify-content-between align-items-center py-2">
    <div class="logo">
        <a class="nav-link text-dark" href="/">
            <img src="../imagenes/logoEmpresa.png" alt="Logo" class="img-fluid">
        </a>
    </div>
    <nav class="navigation">
        <ul class="nav">
            <li class="nav-item">
                <a class="nav-link text-dark" href="#quienes-somos">Quienes Somos</a>
            </li>
            {{#if (isEqual rolUsuario "TECNICO")}}
            {{else}}
            <li class="nav-item">
                <a class="nav-link text-dark" href="/ofertas">Ofertas</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" href="/colaboraciones">Colaborar</a>
            </li>
            {{/if}}
            <li class="nav-item">
                <a class="nav-link text-dark" href="/heladeras">Heladeras</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" href="/donde-donar">Dónde Donar</a>
            </li>
        </ul>
    </nav>

    {{#if rolUsuario}}
        <div class="user-logout-container">
            <div class="dropdown">
                <div type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="{{fotoUsuario}}" alt="Perfil" class="profile">
                </div>
                <ul class="dropdown-menu">
                    {{#if (isEqual rolUsuario "ADMIN")}}
                        <li><a class="dropdown-item" href="/heladeras/reportes">Ver Reportes</a></li>
                        <li><a class="dropdown-item" href="/colaboradores">Ver Colaboradores</a></li>
                        <li><a class="dropdown-item" href="/registro/registro-humano">Administar Registro Humanos</a></li>
                    {{else}}
                        <li><a class="dropdown-item" href="/perfil">Perfil</a></li>
                        {{#if (isEqual rolUsuario "TECNICO")}}
                            <li><a class="dropdown-item" href="/misVisitas">Mis Visitas</a></li>
                            {{else}}
                            <li><a class="dropdown-item" href="/misCanjes">Mis Canjes</a></li>
                            <li><a class="dropdown-item" href="/suscripciones">Suscripciones</a></li>
                        {{/if}}
                    {{/if}}
                </ul>
            </div>

            <form id="form-imagen" action="/logout" method="POST" class="logout">
                <button type="submit" style="border: none; background: none; padding: 0;">
                    <img class="image-logout" src="imagenes/logout.png" alt="Logout" style="cursor: pointer; width: 30px; height:30px; display: block;">
                </button>
            </form>
        </div>
    {{else}}
        <div class="profile ms-3 d-flex align-items-center position-relative">
            <a class="nav-link text-dark" href="/perfil" id="profile-icon">
                <img src="imagenes/fotosUsuarios/user.png" alt="Perfil" class="profile">
            </a>
        </div>
    {{/if}}
</header>

<!-- Main Content - Product Listing -->
<main class="container my-5 d-flex justify-content-center align-items-center">
    {{#block "contenido"}}
    {{/block}}
</main>

<!-- Footer -->
<footer class="container-fluid py-4">
    <div class="container d-flex">

        <div class="footer-logo me-5">
            <a href="/"><img src="../imagenes/logoEmpresa.png" alt="Logo" class="img-fluid mb-2"
                             style="max-width: 100px;"></a>
        </div>

        <div class="footer-content d-flex flex-grow-1 justify-content-between">

            <div class="footer-column text-center">
                <h5>Ayúdanos a ayudar</h5>
                <p>Ayudemos a las personas vulnerables</p>
                <a href="/colaboraciones">
                    <button class="boton">Donar</button>
                </a>
            </div>

            <div class="footer-column text-center">
                <h5>Contacto</h5>
                <p>Email: <a href="mailto:info@example.com" class="text-light">info@example.com</a></p>
                <p>Teléfono: +123456789</p>
                <div class="social-icons d-flex justify-content-center mt-3">
                    <a href="#" class="mx-2">
                        <img src="../imagenes/isntagramLogo.png" alt="Instagram" class="img-fluid social-icon">
                    </a>
                    <a href="#" class="mx-2">
                        <img src="../imagenes/facebookLogo.png" alt="Facebook" class="img-fluid social-icon">
                    </a>
                    <a href="#" class="mx-2">
                        <img src="../imagenes/Youtube_logo.png" alt="YouTube" class="img-fluid social-icon">
                    </a>
                    <a href="#" class="mx-2">
                        <img src="../imagenes/X-Logo.png" alt="X" class="img-fluid social-icon">
                    </a>
                </div>
            </div>

            <div class="footer-column text-center">
                <h5>Explora</h5>
                <ul class="list-unstyled">
                    <li><a href="#" class="">Quienes Somos</a></li>
                    <li><a href="#" class="">Qué Hacemos</a></li>
                    <li><a href="/heladeras/suscribirse" class="">Heladeras</a></li>
                </ul>
            </div>
        </div>
    </div>
</footer>


</body>
</html>