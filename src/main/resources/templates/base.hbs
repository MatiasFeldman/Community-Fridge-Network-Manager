<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product List & Add Product</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="css/style-index.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/header.css">
    <link rel="stylesheet" href="css/footer.css">
    <link rel="stylesheet" href="css/style-btn.css">
    <link rel="stylesheet" href="css/style-gestion-heladeras2.css">
</head>
<body>

<!-- Header -->
<header class="container-fluid bg-platinum border-bottom">
    <div class="container d-flex justify-content-between align-items-center py-2">
        <div class="logo">
            <a class="nav-link text-dark" href="index.html">
                <img src="imagenes/logoEmpresa.png" alt="Logo" class="img-fluid">
            </a>
        </div>
        <div class="search-bar d-flex flex-grow-1 mx-3 position-relative">
            <input type="text" class="form-control rounded-pill ps-4" placeholder="Buscar...">
            <span class="position-absolute end-0 top-50 translate-middle-y pe-3">
                    <img src="imagenes/lupa.png" alt="Buscar" class="img-fluid search-icon">
                </span>
        </div>
        <nav class="navigation">
            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link text-dark" href="#quienes-somos">Quienes Somos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" href="#que-hacemos">Qué Hacemos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" href="donacion.html">Colaborar</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" href="gestion-heladeras2.html">Heladeras</a>
                </li>
            </ul>
        </nav>
        <div class="profile ms-3 d-flex align-items-center position-relative">

            <span id="user-name" class="me-2 text-dark"></span>

            <a class="nav-link text-dark" href="#" id="profile-icon">
                <img src="imagenes/user.png" alt="Perfil" class="img-fluid rounded-circle">
            </a>

            <div class="dropdown" id="profile-dropdown" style="display: none;">
                <div class="dropdown-content">
                    <a href="/mi-cuenta.html">Mi Cuenta</a>
                    <button id="logout-btn" class="btn btn-danger">Cerrar Sesión</button>
                </div>
            </div>
        </div>

    </div>
</header>

<!-- Main Content - Product Listing -->
<main class="container my-5">
    {{#block "contenido"}}
    {{/block}}
</main>

<!-- Footer -->
<footer class="container-fluid py-4">
    <div class="container d-flex">

        <div class="footer-logo me-5">
            <a href="index.html"><img src="imagenes/logoEmpresa.png" alt="Logo" class="img-fluid mb-2" style="max-width: 100px;"></a>
        </div>

        <div class="footer-content d-flex flex-grow-1 justify-content-between">

            <div class="footer-column text-center">
                <h5>Ayúdanos a ayudar</h5>
                <p>Ayudemos a las personas vulnerables</p>
                <a href="donacion.html"><button class="boton">Donar</button></a>
            </div>

            <div class="footer-column text-center">
                <h5>Contacto</h5>
                <p>Email: <a href="mailto:info@example.com" class="text-light">info@example.com</a></p>
                <p>Teléfono: +123456789</p>
                <div class="social-icons d-flex justify-content-center mt-3">
                    <a href="#" class="mx-2">
                        <img src="imagenes/isntagramLogo.png" alt="Instagram" class="img-fluid social-icon">
                    </a>
                    <a href="#" class="mx-2">
                        <img src="imagenes/facebookLogo.png" alt="Facebook" class="img-fluid social-icon">
                    </a>
                    <a href="#" class="mx-2">
                        <img src="imagenes/Youtube_logo.png" alt="YouTube" class="img-fluid social-icon">
                    </a>
                    <a href="#" class="mx-2">
                        <img src="imagenes/X-Logo.png" alt="X" class="img-fluid social-icon">
                    </a>
                </div>
            </div>

            <div class="footer-column text-center">
                <h5>Explora</h5>
                <ul class="list-unstyled">
                    <li><a href="#" class="">Quienes Somos</a></li>
                    <li><a href="#" class="">Qué Hacemos</a></li>
                    <li><a href="gestion-heladeras2.html" class="">Heladeras</a></li>
                </ul>
            </div>
        </div>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>