{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-carga-csv.css">
    <script src="../js/carga-csv.js"></script>
{{/partial}}

{{#partial "contenido"}}
    <div>
        <h1 class="display-4 text-center mb-5">Carga masiva de colaboraciones</h1>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <form id="carga-masiva-form">
                    <div class="mb-4">
                        <label for="archivoCsv" class="form-label h5">Subir archivo (.csv)</label>
                        <input type="file" class="form-control" id="archivoCsv" accept=".csv" required>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="boton fw-bold w-100">Subir Archivo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{{/partial}}
{{> templates/base }}