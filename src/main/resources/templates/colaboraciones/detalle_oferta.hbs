{{#partial "styles"}}
    <link rel="stylesheet" href="../../css/style-detalle-oferta.css">
{{/partial}}

{{#partial "contenido"}}

        <img src="{{#if oferta.image}}{{oferta.image}}{{else}}/imagenes/ofertaDefault.jpg{{/if}}" alt="{{oferta.nombre}}" class="product-image">

        <div class="product-details">
            <h1>{{oferta.nombre}}</h1>
            <p class="puntos-necesarios">Puntos necesarios: {{oferta.puntosNecesarios}}</p>
            <p class="canjes-restantes">Canjes Restantes: {{ofertasRestantes}}</p>
            <!-- Mostrar el mensaje de error si está presente en la URL -->
            {{#if error}}
                <div class="alert alert-danger" role="alert">
                    {{error}} <!-- Aquí se mostrará el mensaje de error directo del backend -->
                </div>
            {{/if}}

            <form method="POST" action="/oferta/{{oferta.id}}/canjear">
                <button type="submit" class="btn btn-primary">Canjear</button>
            </form>
        </div>
{{/partial}}
{{> templates/base }}