{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-donar-dinero.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="row justify-content-center align-items-center">
        <div class="col-md-6">
            <div class="image-container">
                <img src="../imagenes/caridad.jpg" alt="Foto con título" class="img-fluid rounded shadow">
                <h2 class="h5 text-center mt-3">Foto con Título</h2>
            </div>
        </div>
        <div class="col-md-6 d-flex flex-column justify-content-center">
            <h1 class="display-4 font-weight-bold text-center">Donar Dinero</h1>
            <div class="row mt-4">
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Frecuencia</h3>
                    <select class="form-control mt-2" id="frecuencia">
                        <option value="">Seleccione la frecuencia</option>
                        <option value="mensual">Mensual</option>
                        <option value="unica">Única</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Monto</h3>
                    <input type="number" class="form-control mt-2" placeholder="Ingrese el monto" id="monto">
                </div>
            </div>
            <div class="row mt-4">
                <div class="col text-center">
                    <button class="boton" id="donar-btn">Donar</button>
                </div>
            </div>
        </div>
    </div>

{{/partial}}
{{> templates/base }}