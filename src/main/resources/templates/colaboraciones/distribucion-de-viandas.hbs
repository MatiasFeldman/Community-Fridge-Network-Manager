{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-donar-distribucion-vianda.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="row justify-content-center align-items-center">
        <div class="col-md-6">
            <div class="image-container">
                <img src="../imagenes/caridad.jpg" alt="Foto con título" class="img-fluid rounded shadow">
                <h2 class="h5 text-center mt-3">Foto con Título</h2>
            </div>
        </div>
        <div class="col-md-6 d-flex flex-column justify-content-center">
            <h1 class="display-4 font-weight-bold text-center">Distribución de Viandas</h1>
            <div class="row mt-4">
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Heladera Origen</h3>
                    <select class="form-control mt-2" id="heladeraOrigen">
                        <option value="">Ubicación Heladera</option>
                        <option value="ubicacion1">Ubicación 1</option>
                        <option value="ubicacion2">Ubicación 2</option>
                        <option value="ubicacion3">Ubicación 3</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Heladera Destino</h3>
                    <select class="form-control mt-2" id="heladeraDestino">
                        <option value="">Ubicación Heladera</option>
                        <option value="ubicacion1">Ubicación 1</option>
                        <option value="ubicacion2">Ubicación 2</option>
                        <option value="ubicacion3">Ubicación 3</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Cantidad de Viandas</h3>
                    <input type="text" class="form-control mt-2" placeholder="Número" id="cantidadViandas">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Motivo</h3>
                    <input type="text" class="form-control mt-2" placeholder="Motivo de la distribución"
                           id="motivoDistribucion">
                </div>
            </div>
            <div class="row mt-4">
                <div class="col text-center">
                    <button class="boton fs-3 fw-bold" id="distribuir-btn">Distribuir</button>
                </div>
            </div>
        </div>
    </div>
{{/partial}}
{{> templates/base }}