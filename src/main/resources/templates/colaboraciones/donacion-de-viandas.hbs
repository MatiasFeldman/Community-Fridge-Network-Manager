{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-donar-vianda.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="row justify-content-center align-items-center">
        <div class="col-md-6">
            <div class="image-container">
                <img src="../imagenes/caridad.jpg" alt="Foto con título" class="img-fluid rounded shadow">
            </div>
        </div>
        <div class="col-md-6 d-flex flex-column justify-content-center">
            <h1 class="display-4 font-weight-bold text-center">Donar Vianda</h1>
            <form action="/colaboraciones/donacion-viandas" method="POST">
                <div class="row mt-4">
                    <div class="col-12 col-md-6 mb-3">
                        <h3 class="h5">Comida</h3>
                        <input type="text" class="form-control mt-2" name="comidaDonacion" placeholder="ej. Fideos" required>
                    </div>
                    <div class="col-12 col-md-6 mb-3">
                        <h3 class="h5">Ubicación</h3>
                        <select class="form-control mt-2" name="heladera" required>
                            <option value="">Selecciona la Heladera</option>
                            {{#each heladeras}}
                                    <option value="{{this.id}}">{{this.nombre}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="row mt-4">
                    <div class="col text-center">
                        <button class="boton fs-3 fw-bold" type="submit">Donar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
{{/partial}}
{{> templates/base }}