{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-donar-vianda.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="row justify-content-center align-items-center">
        <div class="col-md-6">
            <div class="image-container">
                <img src="../imagenes/caridad.jpg" alt="Foto con título" class="img-fluid rounded shadow">
                <h2 class="h5 text-center mt-3">Foto con Título</h2>
            </div>
        </div>
        <div class="col-md-6 d-flex flex-column justify-content-center">
            <h1 class="display-4 font-weight-bold text-center">Donar Vianda</h1>
            <div class="row mt-4">
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Comida</h3>
                    <input type="text" class="form-control mt-2" placeholder="ej. Fideos" id="comidaDonacion">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Ubicación</h3>
                    <select class="form-control mt-2" id="ubicacionDonacion">
                        <option value="">Ubicación Heladera</option>
                        <option value="ubicacion1">Ubicación 1</option>
                        <option value="ubicacion2">Ubicación 2</option>
                        <option value="ubicacion3">Ubicación 3</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Peso</h3>
                    <input type="text" class="form-control mt-2" placeholder="Peso en kg" id="pesoDonacion">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Caducidad</h3>
                    <input type="text" class="form-control mt-2" placeholder="DD/MM/AA" id="caducidadDonacion">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Calorías (Opcional)</h3>
                    <input type="text" class="form-control mt-2" placeholder="Cant. de calorías"
                           id="caloriasDonacion">
                </div>
            </div>
            <div class="row mt-4">
                <div class="col text-center">
                    <button class="boton" id="donar-btn">Donar</button>
                </div>
            </div>
        </div>
    </div>
{{/partial}}
{{> templates/base }}