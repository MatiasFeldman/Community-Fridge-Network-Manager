{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-donar-heladera.css">

{{/partial}}

{{#partial "contenido"}}
    <div>
        <div class="row justify-content-center align-items-center">
            <div class="col-md-6 d-flex flex-column justify-content-center">
                <h1 class="fw-bold text-center text-dark">Registrar Heladera</h1>
                <form action="/colaborar/heladera-a-cargo" method="POST">
                    <div class="row mt-4">
                        <div class="col-12 col-md-6 mb-3">
                            <h3 class="h5 fw-semibold">Nombre</h3>
                            <input type="text" class="form-control mt-2" name="nombre" placeholder="Nombre" required>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <h3 class="h5 fw-semibold">Capacidad Máxima</h3>
                            <input type="number" class="form-control mt-2" name="capacidadMaxima"
                                   placeholder="Capacidad de viandas" required>
                        </div>
                        {{#if capacidadError}}
                            <span class="text-danger">La capacidad debe ser > 0</span>
                        {{/if}}
                        <div class="col-12 col-md-6 mb-3">
                            <h3 class="h5 fw-semibold">Direccion</h3>
                            <input type="text" class="form-control mt-2" name="calle" placeholder="Calle" required>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <h3 class="h5 fw-semibold">Comuna</h3>
                            <select class="form-control mt-2" name="comuna" required>
                                <option value="">Selecciona la comuna</option>
                                <option value="comuna1">Comuna 1</option>
                                <option value="comuna2">Comuna 2</option>
                                <option value="comuna3">Comuna 3</option>
                                <!-- Se puede completar dinámicamente desde backend -->
                            </select>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <h3 class="h5 fw-semibold">Temperatura Maxima</h3>
                            <input type="number" class="form-control mt-2" name="temperaturaMaxima"
                                   placeholder="temperatura maxima" required>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <h3 class="h5 fw-semibold">Temperatura Minima</h3>
                            <input type="number" class="form-control mt-2" name="temperaturaMinima"
                                   placeholder="temperatura minima" required>
                        </div>
                        {{#if temperaturaError}}
                            <span class="text-danger">Temperatura incorrecta</span>
                        {{/if}}
                        <div class="row mt-4">
                            <div class="col text-center">
                                <button class="boton fs-3 fw-bold" type="submit">Registrar</button>
                            </div>
                        </div>
                </form>
            </div>
                <div class="recomendacion-puntos mt-5">
                    <h2 class="h5 text-recomendacion ps-2">Solicitar Recomendación de Puntos:</h2>
                    <form id="recomendacionForm">
                        <div class="d-flex flex-wrap mt-4 justify-content-between align-items-center">
                            <div class="form-group">
                                <h3 class="text-dark fs-6 fw-semibold ps-2">Latitud</h3>
                                <input type="number" class="form-control latitud" name="latitud" placeholder="Latitud"
                                       required>
                            </div>
                            <div class="form-group">
                                <h3 class="text-dark fs-6 fw-semibold ps-2">Longitud</h3>
                                <input type="number" class="form-control longitud" name="longitud"
                                       placeholder="Longitud" required>
                            </div>
                            <div class="form-group">
                                <h3 class="text-dark fs-6 fw-semibold ps-2">Radio (en metros)</h3>
                                <input type="number" class="form-control radio" name="radio" placeholder="Radio"
                                       required>
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col text-center">
                                <button class="boton fs-3 fw-bold" type="submit">Solicitar Recomendación</button>
                            </div>
                        </div>
                    </form>
                    <!-- Sección de coordenadas recomendadas (inicialmente oculta) -->
                    <div id="recomendacionesContainer" style="display:none;" class="mt-5">
                        <h2 class="h5 text-recomendacion ps-2">Coordenadas Recomendadas:</h2>
                        <ul id="coordenadasList" class="list-group"></ul>
                    </div>
                </div>
                <script>
                    // Manejar el evento submit del formulario
                    document.getElementById("recomendacionForm").addEventListener("submit", function (event) {
                        event.preventDefault();  // Evitar el envío tradicional del formulario

                        // Obtener los valores del formulario
                        const latitud = document.querySelector("input[name='latitud']").value;
                        const longitud = document.querySelector("input[name='longitud']").value;
                        const radio = document.querySelector("input[name='radio']").value;

                        // Crear los datos para la solicitud POST
                        const formData = new URLSearchParams();
                        formData.append("latitud", latitud);
                        formData.append("longitud", longitud);
                        formData.append("radio", radio);

                        // Hacer la solicitud POST
                        fetch("/recomendar-puntos", {
                            method: "POST",
                            body: formData
                        })
                                .then(response => response.json())  // Convertir la respuesta en JSON
                                .then(data => {
                                    console.log(data)

                                })
                                .catch(error => {
                                    console.error('Error:', error);
                                    alert("Hubo un error al obtener las coordenadas recomendadas.");
                                });
                    });
                </script>
            </div>
        </div>
    </div>
{{/partial}}
{{> templates/base }}