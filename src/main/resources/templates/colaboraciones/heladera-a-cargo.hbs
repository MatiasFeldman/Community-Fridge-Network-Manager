{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-donar-heladera.css">
    <script src="../js/recomendarPuntos.js"></script>
{{/partial}}

{{#partial "contenido"}}
    <div class="row justify-content-center align-items-center">
        <div class="col-md-6">
            <div class="image-container">
                <img src="../imagenes/caridad.jpg" alt="Foto con título" class="img-fluid rounded shadow">
                <h2 class="h5 text-center mt-3">Foto con Título</h2>
            </div>
        </div>
        <div class="col-md-6 d-flex flex-column justify-content-center">
            <h1 class="display-4 font-weight-bold text-center">Registrar Heladera</h1>
            <div class="row mt-4">
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Nombre</h3>
                    <input type="text" class="form-control mt-2" placeholder="Nombre" id="nombre">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Capacidad Máxima</h3>
                    <input type="text" class="form-control mt-2" placeholder="Cantidad de viandas"
                           id="capacidadMaxima">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Cantidad Actual(Opcional)</h3>
                    <input type="text" class="form-control mt-2" placeholder="Cantidad actual de viandas"
                           id="cantidadViandas">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Calle</h3>
                    <input type="text" class="form-control mt-2" placeholder="Calle" id="calle">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Altura</h3>
                    <input type="text" class="form-control mt-2" placeholder="Altura" id="altura">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Comuna</h3>
                    <select class="form-control mt-2" id="comuna">
                        <option value="">Selecciona la comuna</option>
                        <option value="comuna1">Comuna 1</option>
                        <option value="comuna2">Comuna 2</option>
                        <option value="comuna3">Comuna 3</option>
                        <!-- creo que tendrian que llegar de el java -->
                    </select>
                </div>
            </div>

        </div>
    </div>

    <!-- Sección de Recomendación de Puntos-->
    <div class="recomendacion-puntos mt-5">
        <h2 class="h5 text-recomendacion">Recomendación de Puntos (Opcional):</h2>
        <div class="row mt-4 justify-content-center">
            <div class="col-12 col-md-3 mb-3">
                <h3 class="h5">Latitud</h3>
                <input type="text" class="form-control mt-2" placeholder="Latitud" id="latitudRecomendacion">
            </div>
            <div class="col-12 col-md-3 mb-3">
                <h3 class="h5">Longitud</h3>
                <input type="text" class="form-control mt-2" placeholder="Longitud" id="longitudRecomendacion">
            </div>
            <div class="col-12 col-md-3 mb-3">
                <h3 class="h5">Radio (en metros)</h3>
                <input type="text" class="form-control mt-2" placeholder="Radio" id="longitudRecomendacion">
            </div>
            <div class="col-12 col-md-3 mb-3">
                <button id="recomendarPuntosBtn" class="boton">Solicitar Recomendación</button>
            </div>
        </div>
        <!-- Sección de resultados -->
        <div class="resultados mt-5" id="resultadosContainer" style="display: none;">
            <h2 class="h5 text-center text-recomendacion">Puntos Recomendados:</h2>
            <ul id="listaPuntosRecomendados" class="list-group">
                <!-- Los puntos recomendados van aca -->
            </ul>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col text-center">
            <button class="boton" id="colocar-btn">Registrar</button>
        </div>
    </div>
{{/partial}}
{{> templates/base }}