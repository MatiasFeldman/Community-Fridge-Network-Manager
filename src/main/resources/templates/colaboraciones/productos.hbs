

    {{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-productos.css">
    <script src="../js/header-log.js"></script>
    <script src="../js/autenticacion.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            checkUserRole(['admin','juridico','colaboradorHumano'],false,false);
        });
    </script>
    {{/partial}}

    {{#partial "contenido"}}
    <h1 class="display-4 text-center mb-5">Productos y Servicios</h1>
    <div class="row">
        <!-- Filtro de rubros -->
        <div class="col-md-3">
            <div class="filter-container p-3 rounded shadow">
                <h3 class="h5 mb-4">Filtrar rubros</h3>
                <form id="filter-form">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="gastronomia" value="gastronomia" name="filtro-rubro">
                        <label class="form-check-label" for="gastronomia">Gastronomía</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="electronica" value="electronica" name="filtro-rubro">
                        <label class="form-check-label" for="electronica">Electrónica</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="articulos-hogar" value="articulos-hogar" name="filtro-rubro">
                        <label class="form-check-label" for="articulos-hogar">Artículos para el hogar</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="otros" value="otros" name="filtro-rubro">
                        <label class="form-check-label" for="otros">Otros</label>
                    </div>
                    <button type="button" class="btn btn-primary mt-4" id="apply-filter">Aplicar Filtro</button>
                </form>
            </div>
        </div>

        <!-- Lista de productos -->
        <div class="col-md-9">
            <div class="text-right mb-4">
                <h3 class="h5" style="color: #333;">Mis puntos: <span id="mis-puntos">{{this.mis_puntos}}</span></h3>
            </div>
            <div id="product-list">
                {{#each productos}}
                    <div class="product-item p-3 mb-4 rounded shadow d-flex">
                        <div class="product-image mr-3">
                            <img src="{{#if imagen}}{{this.imagen}}{{else}}{{this.imagenDefault}}{{/if}}" alt="{{nombre}}" class="img-fluid rounded">
                        </div>
                        <div class="product-details">
                            <h3 class="h5">{{this.nombre}}</h3>
                            <p>Puntos necesarios: {{this.puntos}}</p>
                            <p>Tipo: {{this.tipo}}</p>
                        </div>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
    <script src="../js/productos.js"></script>
    {{/partial}}
    {{> templates/base }}