{{#partial "styles"}}
    <link rel="stylesheet" href="../../css/style-productos.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="container">
        <!-- Título central -->
        <h1 class="display-4 text-center mb-5">Productos y Servicios</h1>

        <div class="row">
            <!-- Filtro de rubros -->
            <div class="col-md-3">
                <div class="filter-container p-3 rounded shadow">
                    <h3 class="h5 mb-4">Filtrar rubros</h3>
                    <form id="filter-form">
                        {{#each rubros}}
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="{{this.id}}" value="{{this.id}}"
                                       name="filtro-rubro">
                                <label class="form-check-label" for="{{this.id}}">{{this.nombre}}</label>
                            </div>
                        {{/each}}
                        <button type="button" class="btn btn-primary mt-4 w-100" id="apply-filter">Aplicar Filtro</button>
                    </form>
                </div>
            </div>

            <!-- Lista de productos -->
            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="h5 text-muted">Mis puntos: <span id="mis-puntos">{{misPuntos}}</span></h3>
                    <h4 class="h5">Ofertas disponibles</h4>
                </div>
                {{#if success}}
                    <div class="alert alert-success" role="alert">
                        ¡Oferta canjeada exitosamente!
                    </div>
                {{/if}}
                <div id="product-list">
                    {{#each ofertas}}
                    <a href="/ofertas/{{this.id}}" class="product-item-link">
                        <div class="product-item p-3 mb-4 rounded shadow-sm d-flex align-items-center">
                            <div class="product-image mr-3">
                                <img src="{{#if this.image}}{{this.image}}{{else}}imagenes/ofertaDefault.jpg{{/if}}"
                                     alt="{{nombre}}" class="img-fluid rounded">
                            </div>
                            <div class="product-details">
                                <h3 class="h5 font-weight-bold mb-1">{{this.nombre}}</h3>
                                <p class="mb-0 text-muted">Puntos necesarios: {{this.puntosNecesarios}}</p>
                            </div>
                        </div>
                    </a>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
{{/partial}}

{{> templates/base }}