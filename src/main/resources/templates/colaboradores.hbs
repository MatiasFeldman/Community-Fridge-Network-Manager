{{#partial "styles"}}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{{/partial}}

{{#partial "contenido"}}
    <div class="container mt-5">
        <h1 class="mb-4">Colaboradores</h1>
        <h2>Humanos</h2>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Foto Perfil</th>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Puntos</th>
                </tr>
            </thead>
            <tbody>
                {{#each humanos}}
                <tr>
                    <td><img src="{{this.foto}}" alt="Foto de perfil" width="50" height="50"></td>
                    <td>{{this.id}}</td>
                    <td>{{this.nombre}}</td>
                    <td>{{this.puntos}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <h2>Jurídicas</h2>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Foto Perfil</th>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Puntos</th>
                </tr>
            </thead>
            <tbody>
                {{#each juridicas}}
                <tr>
                    <td><img src="{{this.foto}}" alt="Foto de perfil" width="50" height="50"></td>
                    <td>{{this.id}}</td>
                    <td>{{this.razonSocial}}</td>
                    <td>{{this.puntos}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
{{/partial}}
{{> templates/base }}