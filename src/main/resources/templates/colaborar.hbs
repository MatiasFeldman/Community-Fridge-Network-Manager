{{#partial "styles"}}
    <link rel="stylesheet" href="css/style-donar.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="js/donacion.js"></script>
{{/partial}}

{{#partial "contenido"}}
    <div class="row">
        <div class="col text-center">
            <h1 class="display-4">Donar</h1>
            <div class="image-container position-relative mt-3">
                <img src="imagenes/caridad.jpg" alt="Imagen principal" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>

    <div class="row mt-4 justify-content-center">
        <div class="col-12 col-md-6 text-center">
            <h3 class="h5">Tipo de Donación</h3>
        </div>
    </div>

    <div class="row mt-3 justify-content-center">
        <div class="col-12 col-md-6 d-flex justify-content-center align-items-center">
            <select class="form-control me-2" id="tipoDonacion">
                <option value="">Seleccione un tipo de donación</option>
                <option value="donacion-dinero.html">Dinero</option>
                <option value="donacion-vianda.html">Vianda</option>
                <option value="distribucion-vianda.html">Distribucion de vianda</option>
                <option value="registro-vulnerable.html">Registro de Vulnerable</option>
                <option value="donacion-heladera.html">Heladera</option>
                <option value="donacion-dinero.html">Dinero2</option>
                <option value="donacion-oferta.html">Oferta</option>

            </select>
            <button class="boton" id="siguiente-btn">Siguiente</button>
        </div>
    </div>
{{/partial}}
{{> templates/base }}