{{#partial "styles"}}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <style>

        .incident-card {
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border: none;
            border-radius: 0.5rem;
            margin-bottom: 2rem;
            padding: 1rem;
            min-height: 350px;
        }
        .incident-card img {
            max-width: 100%;
            height: auto;
            border-radius: 0.5rem;
        }
        .incident-card .status {
            font-weight: bold;
        }
        .incident-card .status.resuelto {
            color: green;
        }
        .incident-card .status.no-resuelto {
            color: red;
        }
    </style>
    <script>

    </script>


{{/partial}}
{{#partial "contenido"}}
<div class="container mt-5">
    <h1>Incidentes de la Heladera</h1>
    <div class="row">
        {{#each incidentes}}
            <div class="col-lg-4 col-md-6 col-sm-12">
                <div class="card incident-card">
                    <div class="card-body">
                        <h5 class="card-title">Fecha de reporte: {{this.fechaReporte}}</h5>
                        <p class="card-text">Tipo de incidente: {{this.tipo}}</p>
                        <p class="card-text">Reportado por:  {{#if this.reportadoPor}}{{this.reportadoPor}}{{else}}Sin Colaborador{{/if}}</p>
                        <p class="card-text">Descripción: {{#if this.descripcion}}{{this.descripcion}}{{else}}Sin Descripción{{/if}} </p>

                        {{#if foto}}
                            <img src="{{this.foto}}" alt="Foto del incidente" class="img-fluid">
                        {{/if}}

                        <p class="status {{#if this.resuelto}}resuelto{{else}}no-resuelto{{/if}}">
                            {{#if this.resuelto}}Resuelto{{else}}No Resuelto{{/if}}
                        </p>
                        {{# if this.resuelto}}
                            <p class="card-text">Fecha de resolución: {{this.fechaResuelto}}</p>
                        {{/if}}
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
</div>
{{/partial}}
{{> templates/base }}
