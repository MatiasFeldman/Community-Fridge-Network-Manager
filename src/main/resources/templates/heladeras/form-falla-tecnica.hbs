{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-carga-csv.css">
    <script src="/js/reportar-falla-tecnica.js"></script>
{{/partial}}

{{#partial "contenido"}}

    <div class="row justify-content-center align-items-center">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                <li class="breadcrumb-item"><a href="/heladeras">Heladeras</a></li>
                <li class="breadcrumb-item active" aria-current="page">Suscripcion</li>
            </ol>
        </nav>
        <div class="col-md-8 d-flex flex-column justify-content-center">
            <h1 class="display-4 font-weight-bold text-center">Reporte Falla Técnica</h1>
                <p class="fw-semibold text-center fs-4">
                    {{heladera.nombre}} - {{heladera.direccion}}
                </p>
            <div class="row mt-4">
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Fecha del incidente</h3>
                    <input type="date" class="form-control mt-2" id="fechaIncidente">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Hora del incidente</h3>
                    <input type="time" class="form-control mt-2" id="horaIncidente">
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Tipo de Incidente</h3>
                    <select class="form-control mt-2" id="tipoIncidente">
                        <option value="">Selecciona el tipo de incidente</option>
                        <option value="electrico">Eléctrico</option>
                        <option value="mecanico">Mecánico</option>
                        <option value="otro">Otro</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <h3 class="h5">Foto</h3>
                    <input type="file" class="form-control mt-2" id="foto" accept="image/png, image/jpeg">
                </div>
                <div class="col-12 mb-3">
                    <h3 class="h5">Descripción</h3>
                    <textarea class="form-control mt-2" rows="4" placeholder="Descripción del incidente"
                              id="descripcion"></textarea>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col text-end ">
                    <button data-id="{{heladera.id}}" class="boton" id="reportar-btn">Reportar</button>
                </div>
            </div>
        </div>
    </div>
{{/partial}}
{{> templates/base }}