{{#partial "styles"}}
    <!-- Enlace a Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Enlace a Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="../css/style-gestion-heladeras-user.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css"/>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script>
        const userRole = {{permisoSuscripcion}};
        const permisoSuscripcion = {{permisoSuscripcion}};
    </script>
    <script src="../js/gestion-heladeras-user.js"></script>

{{/partial}}

{{#partial "contenido"}}
    <div class="w-100">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                <li class="breadcrumb-item active" aria-current="page">Heladeras</li>
            </ol>
        </nav>
        <h1 class="display-4 text-center mb-5">Gestión de Heladeras</h1>
        <div class="filter-container">
            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="collapse"
                    data-bs-target="#filter-options" aria-expanded="false" aria-controls="filter-options">
                <img src="../imagenes/filtro.png" alt="Filtrar" class="filter-icon"> Filtrar
            </button>
            <div class="collapse" id="filter-options">
                <form id="filter-form" method="POST" action="/heladeras/filtrar/estado">
                    <!-- Filtro por estado (agrupado) -->
                    <div>
                        <input type="checkbox" name="activo" id="filtro-activo" value="activo">
                        <label for="filtro-activo">Heladeras Activas</label>

                        <input type="checkbox" name="inactivo" id="filtro-inactivo" value="inactivo">
                        <label for="filtro-inactivo">Heladeras Inactivas</label>
                    </div>

                    <button type="submit">Aplicar Filtro</button>
                </form>

            </div>
            <form id="form-busqueda" class="input-group" method="POST" action="/heladeras/filtrar/busqueda">
                <select class="form-select rounded-start" name="busqueda" id="busqueda">
                    <option value="direccion">Buscar por direccion</option>
                    <option value="comuna">Buscar por departamento/comuna</option>
                    <option value="todas">Buscar todas</option>
                </select>
                <input name="valor" id="input-busqueda" type="text" class="form-control" placeholder="Ingresar...">
                <button id="boton-buscar" class="boton rounded-end d-flex align-items-center" type="submit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search"
                         viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                    </svg>
                </button>
            </form>
        </div>

        <div class="container-page">
            <div class="mapaHeladeras">
                <div id="map"></div>

                <!-- Lista de heladeras -->
                <div class="lista-heladeras " id="lista-heladeras">
                    {{#each heladeras}}
                        <div class="p-3 d-flex flex-column justify-content-between rounded heladera-card"
                             data-id="{{this.id}}" data-nombre="{{this.nombre}}" data-direccion="{{this.direccion}}"
                             data-latitud="{{this.latitud}}" data-longitud="{{this.longitud}}">
                            <div class="d-flex justify-content-between">
                                <h5 class="text-dark fs-5">{{this.nombre}}</h5>
                                <span class="{{#if this.activa}}estado-activa{{else}}estado-inactiva{{/if}}">
                                    {{#if this.activa}}Activa{{else}}Inactiva{{/if}}
                                </span>
                            </div>
                            <div>
                                <p class="text-black fs-5 fw-semibold mb-1">{{this.direccion}}</p>
                                <p class="fs-6 fw-medium text-body-tertiary mb-2">Viandas
                                    disponibles: {{this.capacidadActual}}</p>
                                {{#if permisoSuscripcion}}
                                    <div class="d-flex gap-2">
                                    {{#if this.estaSuscrito}}
                                        <form action="/desuscribirse" method="POST">
                                            <!-- Campo oculto para ID de la heladera -->
                                            <input type="hidden" name="heladera_id" id="heladeraIdInput" value="{{this.id}}">
                                            <button class="boton boton-desuscribirse" type="submit">Desuscribirse</button>
                                        </form>
                                    {{else}}
                                            <a href="/heladeras/{{this.id}}/suscripcion/nueva" class="boton suscribirse-btn">
                                                Suscribirse
                                            </a>
                                    {{/if}}
                                        <a class="boton" href="/heladeras/{{this.id}}/reporte-falla-tecnica/nueva">
                                            Falla técnica
                                        </a>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>



        </div>
    </div>
{{/partial}}
{{> templates/base }}