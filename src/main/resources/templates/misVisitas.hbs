{{#partial "styles"}}
    <link rel="stylesheet" href="/css/style-misVisitas.css">
{{/partial}}
{{#partial "contenido"}}
    <div class="container">
        <h1 class="mb-4 display-4 text-dark text-center fw-bold">Mis Visitas</h1>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            {{#each visitas}}
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <!-- Imagen o mensaje predeterminado -->
                        {{#if this.foto}}
                            <img src="{{this.foto}}" class="card-img-top img-fluid img-contain" alt="Foto de la visita">
                        {{else}}
                            <div class="card-img-placeholder">
                                <p class="text-muted">Sin imagen</p>
                            </div>
                        {{/if}}
                        <div class="card-body">
                            <h4 class="card-title text-dark fs-6 mb-2">Heladera: {{this.heladera}}</h4>
                            <!--<p class="card-text"><strong>Tipo de incidente:</strong> {{this.tipo}}</p>-->
                            <p class="card-text"><strong>Fecha:</strong> {{this.fecha}}</p>
                            <p class="card-text"><strong>Resuelto:</strong>
                                {{#if this.resuelto}}
                                    <span class="text-success">Sí</span>
                                {{else}}
                                    <span class="text-danger">No</span>
                                {{/if}}
                            </p>

                            <p class="card-text"><strong>Descripción:</strong> {{this.descripcion}}</p>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
{{/partial}}
{{> templates/base }}

