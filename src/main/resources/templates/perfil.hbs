{{#partial "styles"}}
    <link rel="stylesheet" href="/css/perfil.css">
{{/partial}}

{{#partial "contenido"}}
    <div>
        <div class="d-flex justify-content-center flex-column gap-3">
            <h1 class="text-dark fw-bold fs-1 text-center">Perfil</h1>
            <picture class="w-100 text-center">
                <img src="{{fotoUsuario}}" alt="Perfil" class="profile2">
            </picture>
            <div class="d-flex flex-row gap-2 justify-content-center align-items-center">
                {{#each roles}}
                    <p class="p-2 fs-6 rol" data-rol-nombre="{{this}}" id="{{this}}">{{this}}</p>
                {{/each}}
            </div>
            <div>
                <p class="text-dark mb-1 text-center fs-2 fw-semibold">{{usuario}} - Id: {{id}} - Puntos disponibles: {{puntos}}</p>
                <form action="/perfil" method="POST" enctype="multipart/form-data" >
                    <div class="campos-usuario">
                        {{#each humano}}
                            <div class="form-group">
                                <label class="text-dark" for="{{this.atributo.nombre}}">{{this.atributo.nombre}}</label>
                                <input id="{{this.atributo.nombre}}" name="{{this.atributo.nombre}}" type="{{this.atributo.tipo}}" value="{{this.valor}}"
                                       placeholder="{{this.valor}}" >
                            </div>
                        {{/each}}
                        {{#if esJuridica}}
                            <div class="form-group">
                                <label class="text-dark" for="razon-social">Razón Social</label>
                                <input id="razon-social" name="razon-social" type="text" value="{{juridica.razonSocial}}"
                                       placeholder="{{juridica.razonSocial}}" disabled="disabled">
                            </div>
                            <div class="form-group">
                                <label class="text-dark" for="tipo">Tipo</label>
                                <input id="tipo" name="tipo" type="text" value="{{juridica.tipo}}" placeholder="{{juridica.tipo}}"
                                       disabled="disabled">
                            </div>
                            <div class="form-group">
                                <label class="text-dark" for="rubro">Rubro</label>
                                <input id="rubro" name="rubro" type="text" value="{{juridica.rubro}}"
                                       placeholder="{{juridica.rubro}}" disabled="disabled">
                            </div>
                            <div class="form-group">
                                <label class="text-dark" for="direccion">Direccion</label>
                                <input id="Direccion" name="direccion" type="text" value="{{juridica.direccion}}"
                                       placeholder="{{juridica.rubro}}">
                            </div>
                            <div class="form-group">
                                <label class="text-dark" for="provincia">Provincia</label>
                                <input id="Provincia" name="provincia" type="text" value="{{juridica.provincia}}"
                                       placeholder="{{juridica.provincia}}">
                            </div>
                            <div class="form-group">
                                <label class="text-dark" for="mail">Mail</label>
                                <input id="Mail" name="mail" type="email" value="{{juridica.mail}}"
                                       placeholder="{{juridica.mail}}">
                            </div>
                            <div class="form-group">
                                <label class="text-dark" for="telegram">Telegram</label>
                                <input id="Telegram" name="telegram" type="tel" value="{{juridica.telegram}}"
                                       placeholder="{{juridica.telegram}}">
                            </div>
                            <div class="form-group">
                                <label class="text-dark" for="whatsapp">Whatsapp</label>
                                <input id="WhatsApp" name="whatsapp" type="tel" value="{{juridica.whatsapp}}"
                                       placeholder="{{juridica.whatsapp}}">
                            </div>

                        {{/if}}


                        {{#if esAdmin}} {{else}}
                            <div class="form-group">
                                <label class="text-dark" for="profilePicture">Sube tu foto de perfil:</label>
                                <input type="file" id="profilePicture" name="imagen" accept="image/*">
                            </div>
                        {{/if}}
                    </div>
                    {{#if esAdmin}} {{else}}
                        <div class="d-flex justify-content-center mt-3">
                            <button type="submit" data-id="{{id}}" class="boton fw-bold w-50 mx-auto my-3" id="guardar">Guardar cambios</button>
                        </div>
                    {{/if}}
                </form>
            </div>

        </div>
    </div>
{{/partial}}
{{> templates/base }}