{{#partial "styles"}}
    <link rel="stylesheet" href="/css/perfil.css">
{{/partial}}

{{#partial "contenido"}}
    <div>
        <div class="d-flex justify-content-center flex-column gap-3">
            <h1 class="text-dark fw-bold fs-1 text-center">Perfil</h1>
            <img src="../imagenes/user.png" alt="Perfil" class="img-fluid rounded-circle">
            <p class="text-dark mb-1 text-center fs-2 fw-semibold">{{usuario.user}}</p>
            <div class="d-flex flex-row gap-2 justify-content-center">
                {{#each roles}}
                    <p class="p-2 fs-6" id="{{this}}">{{this}}</p>
                {{/each}}
            </div>
        </div>
    </div>
{{/partial}}
{{> templates/base }}