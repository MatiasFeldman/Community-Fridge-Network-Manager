{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-modif-humano.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="container">
        <h1 class="display-4 text-center mb-5">Administrar Campos del Formulario de Registro</h1>

        <!-- Sección de Listado de Campos Actuales -->
        <div class="mb-4">
            <h2 class="h4">Campos Actuales</h2>
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>Nombre del Campo</th>
                    <th>Tipo</th>
                    <th>Requerido</th>
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody id="campos-actuales">
                {{#each campos}}
                    <tr>
                        <td>{{this.nombre}}</td>
                        <td>{{this.tipo}}</td>
                        <td>{{#if this.obligatorio}}Si{{else}}No{{/if}}</td>
                        <td class="d-flex">
                            <button id="editar-btn" class="me-2 d-flex align-items-center rounded-circle p-2 btn-editar">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="white"
                                     class="bi bi-pencil" viewBox="0 0 16 16">
                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                </svg>
                            </button>
                            <button id="eliminar-btn" class="btn btn-sm btn-danger d-flex align-items-center rounded-circle p-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                     class="bi bi-trash" viewBox="0 0 16 16">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                </svg>
                            </button>

                        </td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        </div>

        <!-- Sección para Agregar o Editar Campo -->
        <div class="mb-4">
            <h2 class="h4 text-dark" id="form-titulo fw-semibold">Agregar Nuevo Campo</h2>
            <form id="form-campo">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="campo-nombre" class="form-label text-dark fw-medium">Nombre del Campo</label>
                            <input type="text" placeholder="Ingrese el nombre del campo aquí" id="campo-nombre"
                                   name="campo-nombre" class="form-control" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="campo-tipo" class="form-label text-dark fw-medium">Tipo de Campo</label>
                            <select id="campo-tipo" name="campo-tipo" class="form-select" required>
                                <option value="text">Texto</option>
                                <option value="email">Correo Electrónico</option>
                                <option value="tel">Teléfono</option>
                                <option value="date">Fecha</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="campo-placeholder" class="form-label text-dark fw-medium">Placeholder</label>
                            <input type="text" id="campo-placeholder" name="campo-placeholder" class="form-control">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3 form-check">
                            <input type="checkbox" id="campo-requerido" name="campo-requerido" class="form-check-input">
                            <label for="campo-requerido" class="form-check-label text-dark fw-medium">Requerido</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="boton me-2 fw-bold">Guardar Campo</button>
                <button type="button" class="boton fw-bold" id="cancelar-edicion">Cancelar</button>
            </form>
        </div>
    </div>
{{/partial}}
{{> templates/base }}