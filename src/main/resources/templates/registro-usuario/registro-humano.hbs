{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-registros.css">
    <script src="../js/registro-humano.js"></script>
{{/partial}}

{{#partial "contenido"}}
    <div class="form-colaboradorHumano">
        <div class="form-container">
            <h2>Registro de Usuario - Humano</h2>
            <form id="form-colaboradorHumano" class="gap-3 my-3" method="POST" action="/registrar/humano">
                <div class="form-group">
                    <label for="user">Usuario</label>
                    <input type="text" id="user" name="user" required="true" placeholder="Ingrese su username">
                </div>
                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" required="true" placeholder="******">
                </div>
                {{#each campos}}
                    <div class="form-group">
                        <label for="{{this.nombre}}">{{this.nombre}}{{#if this.obligatorio}}
                             *{{else}} (Opcional){{/if}}</label>
                        <input type="{{this.tipo}}" id="{{this.nombre}}" name="{{this.nombre}}"
                               placeholder="Ingrese su {{this.nombre}}">
                    </div>
                {{/each}}

            </form>
            <p class="mt-1 mb-0 fs-6 fw-bold">
                Nota: Los campos marcados con * son obligatorios.
            </p>
            <p class="mt-1 mb-0 fs-6 fw-bold">
                Nota: Debe ser ingresado al menos un medio de contacto para poder registrarse
            </p>
            <button id="btn-submit-humana" class="boton btn-registro mt-3">Registrarse</button>
        </div>
    </div>
{{/partial}}
{{> templates/base }}