{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-registros.css">
    <script src="../js/registro-juridica.js"></script>
{{/partial}}

{{#partial "contenido"}}
    <div class="form-juridico">
        <div class="form-container">
            <h2>Registro de Usuario - Jurídico</h2>
            <form method="POST" action="registro/juridica" id="form-juridico" class="gap-3 my-3">
                <div class="form-group">
                    <label for="user">Usuario *</label>
                    <input class="obligatorio" type="text" id="user" name="user" required="true" placeholder="Ingrese su username">
                    {{#if usuarioExistente}}
                          <span class="text-danger">{{usuarioExistente}}</span>
                    {{/if}}
                </div>
                <div class="form-group">
                    <label for="password">Contraseña *</label>
                    <input class="obligatorio" type="password" id="password" name="password" required="true" placeholder="******">
                    {{#if contraseniaInsegura}}
                          <span class="text-danger">{{contraseniaInsegura}}</span>
                    {{/if}}
                </div>
                <div class="form-group">
                    <label for="razon-social">Razón Social *</label>
                    <input class="obligatorio" type="text" id="razon-social" name="razon-social" required="true" placeholder="Razón social">
                </div>
                <div class="form-group d-flex flex-column">
                    <label for="tipo">Tipo *</label>
                    <select class="obligatorio" id="tipo" name="tipo" required="true" class="flex-grow-1">
                        <option value="GUBERNAMENTAL">Gubernamental</option>
                        <option value="ONG">ONG</option>
                        <option value="EMPRESA">Empresa</option>
                        <option value="INSTITUCION">Institución</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="direccion">Direccion</label>
                    <input type="text" id="direccion" name="direccion" placeholder="Dirección fiscal">
                    {{#if direccionInvalida}}
                          <span class="text-danger">{{direccionInvalida}}</span>
                    {{/if}}
                </div>
                <div class="form-group">
                    <label for="direccion">Provincia</label>
                    <input type="text" id="provincia" name="provincia" placeholder="Si ingresa su direccion, ingrese su provincia">
                </div>
                <div class="form-group">
                    <label for="rubro">Rubro</label>
                    <input type="text" id="rubro" name="rubro" placeholder="Rubro">
                </div>
                <div class="form-group">
                    <label for="Mail">Mail (Opcional)</label>
                    <input type="EMAIL" id="Mail" name="Mail" placeholder="Ingrese su Mail">
                </div>
                <div class="form-group">
                    <label for="Whatsapp">Whatsapp (Opcional)</label>
                    <input type="TEL" id="Whatsapp" name="Whatsapp" placeholder="Ingrese su Whatsapp">
                </div>
                <div class="form-group">
                    <label for="Telegram">Telegram (Opcional)</label>
                    <label for="Telegram"></label><input type="TEL" id="Telegram" name="Telegram"
                                                         placeholder="Ingrese su Telegram">
                </div>

                <p class="mt-1 mb-0 fs-6 fw-bold">
                    Nota: Los campos marcados con * son obligatorios.
                </p>
                <p class="mt-1 mb-0 fs-6 fw-bold">
                    Nota: Debe ser ingresado al menos un medio de contacto para poder registrarse
                </p>
                <button id="btn-submit-juridica" type="submit" class="boton btn-registro mt-3">Registrarse</button>
            </form>
        </div>
    </div>
{{/partial}}
{{> templates/base }}