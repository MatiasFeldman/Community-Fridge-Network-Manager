{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-registros.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="form-juridico">
        <div class="form-container">
            <h2>Registro de Usuario - Tecnico</h2>
            <form method="POST" action="registro/tecnico" id="form-juridico" class="gap-3 my-3">
                <div class="form-group">
                    <label for="user">Usuario *</label>
                    <input class="obligatorio" type="text" id="user" name="user" required="true" placeholder="Ingrese su username" value="{{username}}">
                    {{#if usuarioExistente}}
                        <span class="text-danger">{{usuarioExistente}}</span>
                    {{/if}}
                </div>
                <div class="form-group">
                    <label for="password">Contraseña *</label>
                    <input class="obligatorio" type="password" id="password" name="password" required="true" placeholder="******" value="{{password}}">
                    {{#if contraseniaInsegura}}
                        <span class="text-danger">{{contraseniaInsegura}}</span>
                    {{/if}}
                </div>
                <div class="form-group">
                    <label for="nombre">Nombre *</label>
                    <input value="{{nombre}}" class="obligatorio" type="text" id="nombre" name="nombre" required placeholder="Nombre" value="{{nombre}}">
                </div>
                <div class="form-group">
                    <label for="apellido">Apellido *</label>
                    <input value="{{apellido}}" type="text" id="apellido" name="apellido" required placeholder="Apellido" value="{{apellido}}">
                </div>
                <div class="form-group d-flex flex-column">
                    <label for="tipo_documento">Tipo de documento *</label>
                    <select class="obligatorio" id="tipo_documento" name="tipo_documento" required="true" class="flex-grow-1">
                        {{#each tipos}}
                            <option value="{{this.valor}}" selected >{{this.nombre}} {{#if (isEqual tipo_documento this.valor)}} selected {{/if}} </option>
                        {{/each}}
                    </select>
                </div>
                <div class="form-group">
                    <label for="nroDocumento">Numero de documento *</label>
                    <input value="{{nroDocumento}}" type="text" id="nroDocumento" name="nroDocumento" required placeholder="Numero de documento">
                    {{#if errorDocumento}}
                        <span class="text-danger">{{errorDocumento}}</span>
                    {{/if}}
                </div>
                <div class="form-group">
                    <label for="direccion">Area de Cobertura: Direccion central *</label>
                    <input value="{{direccion}}" type="text" id="direccion" name="direccion" required placeholder="direccion" value="{{direccion}}">
                </div>
                <div class="form-group">
                    <label for="radio"> Radio (en metros) *</label>
                    <input value="{{radio}}" type="number" id="radio" name="radio" required placeholder="radio" value="{{radio}}">
                </div>
                <div class="form-group">
                    <label for="provincia">provincia *</label>
                    <input value="{{provincia}}" type="text" id="provincia" name="provincia" required placeholder="provincia" value="{{provincia}}">
                </div>
                <div class="form-group">
                    <label for="nroCUIL">CUIL *</label>
                    <input value="{{nroCUIL}}" type="text" id="nroCUIL" name="nroCUIL" required placeholder="CUIL" value="{{nroCUIL}}">
                </div>
                <div class="form-group">
                    <label for="Mail">Mail (Opcional)</label>
                    <input value="{{email}}" type="EMAIL" id="Mail" name="Mail" placeholder="Ingrese su Mail" value="{{email}}">
                </div>
                <div class="form-group">
                    <label for="Whatsapp">Whatsapp (Opcional)</label>
                    <input value="{{whatsapp}}" type="TEL" id="Whatsapp" name="Whatsapp" placeholder="Ingrese su Whatsapp" value="{{whatsapp}}">
                </div>
                <div class="form-group">
                    <label for="Telegram">Telegram (Opcional)</label>
                    <input value="{{telegram}}" type="TEL" id="Telegram" name="Telegram" placeholder="Ingrese su Telegram" value="{{telegram}}">
                </div>
                <div class="form-group">
                </div>

                <p class="mt-1 mb-0 fs-6 fw-bold">
                    Nota: Los campos marcados con * son obligatorios.
                </p>
                <p class="mt-1 mb-0 fs-6 fw-bold">
                    Nota: Debe ser ingresado al menos un medio de contacto para poder registrarse
                </p>
                <button id="btn-submit-juridica" type="submit" class="boton btn-registro mt-3">Registrarse</button>
            </form>
        </div>
    </div>
{{/partial}}
{{> templates/base }}