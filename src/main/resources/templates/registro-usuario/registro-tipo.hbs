{{#partial "styles"}}
    <link rel="stylesheet" href="../css/style-registros.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="register-page">
        <div class="register-container">
            <h2>Registro de Usuario</h2>
            <p class="login">Ya tenes cuenta? <a href="/login">Login</a></p>
            <p>Antes de empezar a registrarte, contanos con qué tipo de entidad te quieres registrar:</p>
            <div class="option-group text-center">
                <button id="register-btn-humana" class="boton mx-3">Persona Humana</button>
                <button id="register-btn-juridica" class="boton mx-3">Persona Jurídica</button>
                <button id="register-btn-tecnico" class="boton mx-3">Tecnico</button>
            </div>
        </div>
    </div>
    <script src="../js/registro.js"></script>
{{/partial}}
{{> templates/base }}